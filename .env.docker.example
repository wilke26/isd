# Diese Werte werden von docker-compose.yml gelesen (UID/GID, DB-Zugangsdaten für den Container).
# Kopieren nach .env im Projekt-Root, NICHT mit der Laravel-.env verwechseln/überschreiben.

UID=1000
GID=1000

DB_DATABASE=it_service_desk
DB_USERNAME=isd_user
DB_PASSWORD=secret
DB_ROOT_PASSWORD=rootsecret

# off | debug  – steuert Xdebug im app-Container
XDEBUG_MODE=off
