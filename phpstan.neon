includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    # Startlevel bewusst moderat (0-9 möglich). Bei einem neuen Projekt empfiehlt
    # es sich, mit einer niedrigeren Stufe zu beginnen und sie schrittweise zu
    # erhöhen, statt direkt mit Level 8/9 anzufangen und von Fehlern überflutet
    # zu werden.
    level: 5

    excludePaths:
        - app/Console/Kernel.php
        - database/migrations/*

    # Laravel-typische "magische" Aufrufe (z.B. dynamische Eloquent-Attribute,
    # Facade-Methoden) erzeugen ohne Larastan viele False Positives. Die
    # extension.neon oben deckt das Meiste bereits ab; folgende Optionen
    # reduzieren zusätzliches Rauschen in der Anfangsphase:
    checkMissingIterableValueType: false
    checkGenericClassInNonGenericObjectType: false

    ignoreErrors:
        # Beispiel: Policies erhalten teils ein nullable $user (Guest-Zugriffe),
        # was Larastan in einigen Laravel-Versionen falsch typisiert.
        # - '#Parameter \#1 \$user of method .*Policy#'

    tmpDir: build/phpstan
