includes:
    - vendor/larastan/larastan/extension.neon

parameters:
    paths:
        - app
        - config
        - database
        - routes

    # Ide-Helper generiert IdeHelperXxx-Klassen mit den echten, aus casts() und
    # Relationen abgeleiteten Property-Typen. @mixin-Tags in den Models verweisen
    # darauf — PHPStan muss die Datei aber explizit "scannen" (nicht analysieren),
    # sonst bleiben die referenzierten Klassen unauffindbar und der Mixin wird
    # stillschweigend ignoriert.
    scanFiles:
        - _ide_helper_models.php

    # Startlevel bewusst moderat (0-9 möglich). Bei einem neuen Projekt empfiehlt
    # es sich, mit einer niedrigeren Stufe zu beginnen und sie schrittweise zu
    # erhöhen, statt direkt mit Level 8/9 anzufangen und von Fehlern überflutet
    # zu werden.
    level: 5

    excludePaths:
        - app/Console/Kernel.php (?)
        - database/migrations/*

    ignoreErrors:
        # Larastans Redis-Facade-Stub kennt die pipeline(callable)-Signatur nicht
        # vollständig — die zugrunde liegende Illuminate\Redis\Connections\Connection
        # akzeptiert den Callback tatsächlich (siehe Laravel-Dokumentation zu
        # Redis-Pipelines). Kein echter Bug, sondern ein unvollständiger Stub.
        - '#Static method Redis::pipeline\(\) invoked with 1 parameter, 0 required#'

    tmpDir: /tmp/phpstan
